{
  "name": "pokedex-qr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pokédex PWA de Kanto: captura Pokémon escaneando códigos QR.",
  "author": "Maria Isabel Ceballos Girón",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.cjs -i src/input.css -o css/styles.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.cjs -i src/input.css -o css/styles.css --watch"
  },
  "devDependencies": {
    "@fontsource/press-start-2p": "^5.2.0",
    "@fontsource/vt323": "^5.2.0",
    "html5-qrcode": "^2.3.8",
    "tailwindcss": "^3.4.17"
  }
}
